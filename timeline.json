 "lines": [
  {
   "name": "noob_wait",
   "who": "noob",
   "text": "Okay, wait. Before THAT happens...",
   "vo": false,
   "caption": true,
   "start": 1.3,
   "end": 3.48
  },
  {
   "name": "noob_hi",
   "who": "noob",
   "text": "Hi, new people! You have no idea what's going on.",
   "vo": false,
   "caption": true,
   "start": 4.93,
   "end": 8.077
  },
  {
   "name": "noob_same",
   "who": "noob",
   "text": "...Same.",
   "vo": false,
   "caption": true,
   "start": 8.427,
   "end": 8.933
  },
  {
   "name": "steve_eight",
   "who": "steve",
   "text": "Eight episodes of problems. Patch. Show them.",
   "vo": false,
   "caption": true,
   "start": 9.283,
   "end": 11.422
  },
  {
   "name": "patch_archive",
   "who": "patch",
   "text": "Rewinding. To the very start.",
   "vo": false,
   "caption": true,
   "start": 11.522,
   "end": 14.261
  },
  {
   "name": "noob_falling",
   "who": "noob",
   "text": "That's us. Falling. Spoiler: it's the end.",
   "vo": false,
   "caption": true,
   "start": 15.581,
   "end": 18.21
  },
  {
   "name": "steve_beginning",
   "who": "steve",
   "text": "It's the beginning.",
   "vo": false,
   "caption": true,
   "start": 18.26,
   "end": 18.978
  },
  {
   "name": "noob_deep",
   "who": "noob",
   "text": "It's the end AND the beginning. Deep.",
   "vo": false,
   "caption": true,
   "start": 19.278,
   "end": 21.648
  },
  {
   "name": "noob_ep1",
   "who": "noob",
   "text": "Episode one. I punched a tree. It floated.",
   "vo": false,
   "caption": true,
   "start": 22.398,
   "end": 25.109
  },
  {
   "name": "steve_sky",
   "who": "steve",
   "text": "Then the sky cracked open...",
   "vo": false,
   "caption": true,
   "start": 25.209,
   "end": 26.512
  },
  {
   "name": "patch_eye",
   "who": "patch",
   "text": "...and something looked down at us.",
   "vo": false,
   "caption": true,
   "start": 26.562,
   "end": 29.049
  },
  {
   "name": "patch_unknown",
   "who": "patch",
   "text": "Unknown. But it saw everything.",
   "vo": false,
   "caption": true,
   "start": 29.449,
   "end": 31.991
  },
  {
   "name": "steve_plan",
   "who": "steve",
   "text": "So I made a plan. Leave, before that eye came back.",
   "vo": false,
   "caption": true,
   "start": 32.941,
   "end": 36.014
  },
  {
   "name": "steve_steps",
   "who": "steve",
   "text": "Portal home. Three steps. Nobody touches anything.",
   "vo": false,
   "caption": true,
   "start": 36.114,
   "end": 39.037
  },
  {
   "name": "noob_button",
   "who": "noob",
   "text": "There was a BUTTON!",
   "vo": false,
   "caption": true,
   "start": 39.087,
   "end": 40.111
  },
  {
   "name": "steve_three",
   "who": "steve",
   "text": "The plan lasted three seconds.",
   "vo": false,
   "caption": true,
   "start": 40.511,
   "end": 42.175
  },
  {
   "name": "patch_waved",
   "who": "patch",
   "text": "Then, inside the portal... something waved back.",
   "vo": false,
   "caption": true,
   "start": 42.525,
   "end": 46.675
  },
  {
   "name": "noob_polite",
   "who": "noob",
   "text": "I waved first! I was being polite!",
   "vo": false,
   "caption": true,
   "start": 46.975,
   "end": 48.794
  },
  {
   "name": "steve_watching",
   "who": "steve",
   "text": "First the eye. Then that. Something was watching us.",
   "vo": false,
   "caption": true,
   "start": 49.294,
   "end": 52.033
  },
  {
   "name": "noob_dragon",
   "who": "noob",
   "text": "We put a dragon in an obby!",
   "vo": false,
   "caption": true,
   "start": 52.933,
   "end": 54.425
  },
  {
   "name": "steve_you",
   "who": "steve",
   "text": "YOU put a dragon in an obby.",
   "vo": false,
   "caption": true,
   "start": 54.475,
   "end": 56.209
  },
  {
   "name": "noob_block",
   "who": "noob",
   "text": "Then the dragon glitched... and dropped a weird block!",
   "vo": false,
   "caption": true,
   "start": 57.109,
   "end": 59.45
  },
  {
   "name": "steve_exist",
   "who": "steve",
   "text": "A block that shouldn't exist. Nobody knows why.",
   "vo": false,
   "caption": true,
   "start": 59.55,
   "end": 62.035
  },
  {
   "name": "noob_touched",
   "who": "noob",
   "text": "So I touched it.",
   "vo": false,
   "caption": true,
   "start": 62.085,
   "end": 62.84
  },
  {
   "name": "patch_grew",
   "who": "patch",
   "text": "It grew bigger... every time he died.",
   "vo": false,
   "caption": true,
   "start": 63.29,
   "end": 65.503
  },
  {
   "name": "patch_arrived",
   "who": "patch",
   "text": "And then I arrived. Things improved.",
   "vo": false,
   "caption": true,
   "start": 65.903,
   "end": 68.073
  },
  {
   "name": "steve_weirder",
   "who": "steve",
   "text": "Things got weirder.",
   "vo": false,
   "caption": true,
   "start": 68.123,
   "end": 69.276
  },
  {
   "name": "patch_improvement",
   "who": "patch",
   "text": "...Weirder is an improvement.",
   "vo": false,
   "caption": true,
   "start": 69.776,
   "end": 70.947
  },
  {
   "name": "noob_creative",
   "who": "noob",
   "text": "Then the block gave me CREATIVE MODE! I built everything!",
   "vo": false,
   "caption": true,
   "start": 71.847,
   "end": 75.962
  },
  {
   "name": "patch_belong",
   "who": "patch",
   "text": "None of it belonged in this world. So the world started deleting it...",
   "vo": false,
   "caption": true,
   "start": 76.062,
   "end": 79.929
  },
  {
   "name": "patch_worse",
   "who": "patch",
   "text": "...and everything around it.",
   "vo": false,
   "caption": true,
   "start": 79.979,
   "end": 81.41
  },
  {
   "name": "noob_duck",
   "who": "noob",
   "text": "...RIP duck.",
   "vo": false,
   "caption": true,
   "start": 81.91,
   "end": 83.043
  },
  {
   "name": "noob_dontlike",
   "who": "noob",
   "text": "...I don't like that guy.",
   "vo": false,
   "caption": true,
   "start": 84.443,
   "end": 85.688
  },
  {
   "name": "steve_nobody",
   "who": "steve",
   "text": "Nobody likes that guy.",
   "vo": false,
   "caption": true,
   "start": 85.738,
   "end": 87.564
  },
  {
   "name": "patch_behind",
   "who": "patch",
   "text": "Every time he respawns... something stays behind.",
   "vo": false,
   "caption": true,
   "start": 88.464,
   "end": 91.71
  },
  {
   "name": "steve_sense",
   "who": "steve",
   "text": "So some things started making sense...",
   "vo": false,
   "caption": true,
   "start": 92.01,
   "end": 94.261
  },
  {
   "name": "noob_bigger",
   "who": "noob",
   "text": "...and the questions got WAY bigger.",
   "vo": false,
   "caption": true,
   "start": 94.261,
   "end": 95.929
  },
  {
   "name": "steve_howmany",
   "who": "steve",
   "text": "And how many times have we done this?",
   "vo": false,
   "caption": true,
   "start": 96.129,
   "end": 97.983
  },
  {
   "name": "noob_you",
   "who": "noob",
   "text": "And YOU. Built. The FIRST portal.",
   "vo": false,
   "caption": true,
   "start": 98.983,
   "end": 102.018
  },
  {
   "name": "steve_next",
   "who": "steve",
   "text": "...Patch. Next slide.",
   "vo": false,
   "caption": true,
   "start": 102.468,
   "end": 104.116
  },
  {
   "name": "noob_dontnext",
   "who": "noob",
   "text": "Don't 'next slide' me!",
   "vo": false,
   "caption": true,
   "start": 104.116,
   "end": 105.959
  },
  {
   "name": "patch_lastslide",
   "who": "patch",
   "text": "...That was the last slide.",
   "vo": false,
   "caption": true,
   "start": 106.459,
   "end": 108.012
  },
  {
   "name": "patch_theories",
   "who": "patch",
   "text": "The observers have theories.",
   "vo": false,
   "caption": true,
   "start": 108.512,
   "end": 110.319
  },
  {
   "name": "noob_oneofus",
   "who": "noob",
   "text": "One of us shouldn't be in this world...",
   "vo": false,
   "caption": true,
   "start": 112.039,
   "end": 114.402
  },
  {
   "name": "noob_itsyou",
   "who": "noob",
   "text": "It's you. You're ALWAYS holding a pickaxe.",
   "vo": false,
   "caption": true,
   "start": 114.822,
   "end": 117.601
  },
  {
   "name": "steve_dying",
   "who": "steve",
   "text": "You're always DYING.",
   "vo": false,
   "caption": true,
   "start": 117.651,
   "end": 118.561
  },
  {
   "name": "noob_which",
   "who": "noob",
   "text": "...Patch? Which one?",
   "vo": false,
   "caption": true,
   "start": 119.161,
   "end": 120.151
  },
  {
   "name": "patch_nocomment",
   "who": "patch",
   "text": "No comment.",
   "vo": false,
   "caption": true,
   "start": 121.371,
   "end": 122.439
  },
  {
   "name": "patch_budget",
   "who": "patch",
   "text": "Good news. The finale has a budget.",
   "vo": false,
   "caption": true,
   "start": 122.789,
   "end": 125.232
  },
  {
   "name": "noob_what",
   "who": "noob",
   "text": "A what?",
   "vo": false,
   "caption": true,
   "start": 125.332,
   "end": 126.008
  },
  {
   "name": "patch_upgrade",
   "who": "patch",
   "text": "Upgrade starting. Please do not move.",
   "vo": false,
   "caption": true,
   "start": 126.108,
   "end": 128.231
  },
  {
   "name": "steve_hair",
   "who": "steve",
   "text": "...I have hair. Real hair.",
   "vo": false,
   "caption": true,
   "start": 131.951,
   "end": 135.214
  },
  {
   "name": "noob_beautiful",
   "who": "noob",
   "text": "It's beauti\u2014",
   "vo": false,
   "caption": true,
   "start": 135.714,
   "end": 136.184
  },
  {
   "name": "steve_dont",
   "who": "steve",
   "text": "Don't.",
   "vo": false,
   "caption": true,
   "start": 136.164,
   "end": 136.621
  },
  {
   "name": "noob_textured",
   "who": "noob",
   "text": "Why do I feel... textured?",
   "vo": false,
   "caption": true,
   "start": 140.041,
   "end": 142.751
  },
  {
   "name": "steve_welcome",
   "who": "steve",
   "text": "Welcome to Minecraft.",
   "vo": false,
   "caption": true,
   "start": 142.751,
   "end": 143.721
  },
  {
   "name": "noob_smile",
   "who": "noob",
   "text": "PATCH CAN SMILE?!",
   "vo": false,
   "caption": true,
   "start": 146.041,
   "end": 147.863
  },
  {
   "name": "patch_always",
   "who": "patch",
   "text": "I always could. Now you can see it.",
   "vo": false,
   "caption": true,
   "start": 148.263,
   "end": 151.469
  },
  {
   "name": "noob_woah",
   "who": "noob",
   "text": "Woooah.",
   "vo": false,
   "caption": true,
   "start": 155.089,
   "end": 156.699
  },
  {
   "name": "steve_nice",
   "who": "steve",
   "text": "That's... nice.",
   "vo": false,
   "caption": true,
   "start": 156.949,
   "end": 158.699
  },
  {
   "name": "noob_him",
   "who": "noob",
   "text": "Do you think HE got upgraded too?",
   "vo": false,
   "caption": true,
   "start": 158.999,
   "end": 160.924
  },
  {
   "name": "steve_quiet",
   "who": "steve",
   "text": "...Why did it go quiet?",
   "vo": false,
   "caption": true,
   "start": 162.344,
   "end": 163.358
  },
  {
   "name": "noob_run",
   "who": "noob",
